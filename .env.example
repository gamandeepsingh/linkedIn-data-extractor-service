# LinkedIn account the server logs in with.
# Accounts with 2FA or an email challenge will not work.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Optional third fallback strategy. Voyager GraphQL query ids rotate with every
# web release, so copy one out of a devtools request to /voyager/api/graphql.
# LINKEDIN_GRAPHQL_QUERY_ID=voyagerIdentityDashProfiles.<hash>

# Mongo. Optional for caching, but strongly recommended: it also persists the
# logged-in session so every cold start does not trigger a fresh login.
MONGODB_URI=
MONGODB_DB=tross_linkedin

CACHE_TTL_SECONDS=86400

# If set, callers must send `x-api-key: <value>`.
API_KEY=

RATE_LIMIT_PER_MINUTE=20
